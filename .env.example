# Build-time credentials for KM0 Cloud user count (homepage #cloud-users section).
# Copy to .env and fill in values. Never commit .env.
#
# CLOUD_APP_TOKEN is an OpenCloud app token with user read access.
# It expires after 12 months; renew in OpenCloud admin and update .env before rebuild.
#
# Used at `npm run build` and `docker compose build` (via build args from this file).
CLOUD_ADMIN_USER=
CLOUD_APP_TOKEN=

# Optional: ideas widget trust password (host receive-idea.sh / autoissue).
# When the client sends a matching `password` field, the queue JSON gets
# skipHumanValidation=true and autoissue omits "waiting for human validation".
# Never commit the real value. May also live in autoagents/.env.
# KM0_IDEAS_TRUST_PASSWORD=

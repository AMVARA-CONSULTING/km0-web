# GitHub + autoagents (optional, copy to .env, never commit)

# Fine-grained PAT for Luipy56 - Issues: Read and write (comments, labels, close)
# Expiration: max 366 days (AMVARA-CONSULTING org policy)
# GH_TOKEN=github_pat_...

AGENT_GH_REPO=AMVARA-CONSULTING/km0-web
AGENT_GIT_BRANCH=main

# Optional ideas trust password (also accepted from repo-root .env).
# KM0_IDEAS_TRUST_PASSWORD=

# Committer: 1 = full committer via cursor-agent (040-committer.md)
# Note: 001 time-of-last-review.txt is gitignored; stamp-only commits are skipped.
AGENT_COMMITTER_USE_CURSOR=1

# Runtime digest and gh stderr (inside repo; do not use /tmp)
# AGENT_LOOP_TMP=autoagents/.runtime

# Redmine completion notes (optional, posted when a CLOSED task is archived)
# REDMINE_BASE_URL=https://redmine.amvara.de
# REDMINE_API_KEY=your_api_key
# REDMINE_ISSUE_ID=7529
# REDMINE_ACTIVITY_ID=10

---
import type { Locale } from '../i18n/types';
import type { Messages } from '../i18n/types';
import { localeHref, guidePostHref } from '../i18n/paths';
import { getCollection } from 'astro:content';
import { guideSlug, compareGuides } from '../lib/guide';

interface Props {
  locale: Locale;
  messages: Messages;
}

const { locale, messages: m } = Astro.props;

const guides = (await getCollection('guides', ({ data }) => data.locale === locale))
  .sort(compareGuides)
  .slice(0, 3);
---

<section id="guides" class="section-pad guides-home" aria-labelledby="guides-home-heading">
  <div class="mx-auto max-w-6xl">
    <header class="guides-home__header" data-reveal>
      <h2 id="guides-home-heading" class="heading-section text-navy">
        {m.guides.home.heading}
      </h2>
      <p class="guides-home__intro">{m.guides.home.intro}</p>
    </header>

    <ol class="guides-home__list">
      {
        guides.map((guide, i) => {
          const slug = guideSlug(guide);
          return (
            <li data-reveal data-delay={String(80 + i * 70)} class="guides-home__item">
              <p class="guides-home__meta">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="guides-home__title">
                <a
                  href={guidePostHref(locale, slug)}
                  data-analytics="guide_view"
                  data-guide-slug={slug}
                >
                  {guide.data.teaser}
                </a>
              </h3>
              <p class="guides-home__dek">{guide.data.description}</p>
            </li>
          );
        })
      }
    </ol>

    <p data-reveal data-delay="280" class="guides-home__more">
      <a href={localeHref(locale, '/guides/')} class="guides-home__more-link">
        {m.guides.home.viewAll}
      </a>
    </p>
  </div>
</section>

<style>
  .guides-home__header {
    max-width: 36rem;
    margin-bottom: 2.25rem;
  }

  .guides-home__intro {
    margin: 0.85rem 0 0;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: color-mix(in srgb, var(--color-ink) 82%, transparent);
  }

  .guides-home__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--color-mist);
  }

  .guides-home__item {
    display: grid;
    gap: 0.35rem 1.25rem;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--color-mist);
  }

  @media (min-width: 768px) {
    .guides-home__item {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-items: start;
    }

    .guides-home__meta {
      grid-row: 1 / span 2;
      padding-top: 0.2rem;
    }

    .guides-home__title {
      grid-column: 2;
    }

    .guides-home__dek {
      grid-column: 2;
    }
  }

  .guides-home__meta {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-signal);
  }

  .guides-home__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .guides-home__title a {
    color: var(--color-ink);
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  .guides-home__title a:hover {
    color: var(--color-signal);
    text-decoration: underline;
    text-decoration-color: var(--color-signal);
  }

  .guides-home__title a:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 4px;
  }

  .guides-home__dek {
    margin: 0;
    max-width: 42rem;
    font-family: var(--font-body);
    font-size: 0.9875rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--color-ink) 78%, transparent);
  }

  .guides-home__more {
    margin: 1.75rem 0 0;
  }

  .guides-home__more-link {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--color-signal) 45%, transparent);
    text-underline-offset: 0.2em;
  }

  .guides-home__more-link:hover {
    color: var(--color-signal);
    text-decoration-color: var(--color-signal);
  }

  .guides-home__more-link:focus-visible {
    outline: 2px solid var(--color-signal);
    outline-offset: 4px;
  }
</style>

---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Faq from '../components/Faq.astro';
import Layout from '../layouts/Layout.astro';
import { getMessages } from '../i18n';
import { localeHref } from '../i18n/paths';
import type { Locale } from '../i18n/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const messages = getMessages(locale);
const f = messages.faq;

const siteRoot = Astro.site ?? new URL('https://km0digital.com');
const canonicalUrl = new URL(localeHref(locale, '/faq/'), siteRoot).href;
---

<Layout
  locale={locale}
  messages={messages}
  canonicalUrl={canonicalUrl}
  pageTitle={f.metaTitle}
  pageDescription={f.metaDescription}
>
  <Header locale={locale} messages={messages} />
  <main class="page-shell">
    <div class="section-pad !pt-10 md:!pt-14">
      <header class="page-masthead mx-auto max-w-4xl" data-reveal>
        <p class="doc-kicker">{f.eyebrow}</p>
        <h1 id="faq-heading" class="heading-page text-ink">{f.heading}</h1>
        <p class="doc-index-intro">{f.intro}</p>
      </header>
      <Faq messages={messages} showHeading={false} />
    </div>
  </main>
  <Footer locale={locale} messages={messages} />
</Layout>
